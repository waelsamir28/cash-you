# Copy this file to .env.local and set the connection string from Neon.
# Use Neon's pooled connection string for the running app and sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Public ECDSA P-256 verification key, PEM format (safe to expose; never put the private key here).
# Configure this after creating your offline licensing key pair.
NEXT_PUBLIC_ACTIVATION_PUBLIC_KEY=
