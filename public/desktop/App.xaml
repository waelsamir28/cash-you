<Application x:Class="CashYou.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

    <Application.Resources>
        <ResourceDictionary>

            <!-- ================== لوحة ألوان كاش يو ================== -->
            <Color x:Key="Ink950">#FF020617</Color>
            <Color x:Key="Ink900">#FF0F172A</Color>
            <Color x:Key="Ink800">#FF1E293B</Color>
            <Color x:Key="Ink700">#FF334155</Color>
            <Color x:Key="Ink600">#FF475569</Color>
            <Color x:Key="AmberBrand">#FFF59E0B</Color>
            <Color x:Key="AmberSoft">#FFFEF08A</Color>
            <Color x:Key="AmberCream">#FFFEF9C3</Color>
            <Color x:Key="CashGreen">#FF10B981</Color>
            <Color x:Key="CashGreenDeep">#FF047857</Color>
            <Color x:Key="CashRed">#FFEF4444</Color>
            <Color x:Key="CashOrange">#FFF97316</Color>
            <Color x:Key="CashCyan">#FF22D3EE</Color>
            <Color x:Key="Paper">#FFF1F5F9</Color>
            <Color x:Key="Line">#FFCBD5E1</Color>

            <SolidColorBrush x:Key="BrInk800" Color="{StaticResource Ink800}" />
            <SolidColorBrush x:Key="BrInk700" Color="{StaticResource Ink700}" />
            <SolidColorBrush x:Key="BrInk600" Color="{StaticResource Ink600}" />
            <SolidColorBrush x:Key="BrAmber" Color="{StaticResource AmberBrand}" />
            <SolidColorBrush x:Key="BrAmberSoft" Color="{StaticResource AmberSoft}" />
            <SolidColorBrush x:Key="BrAmberCream" Color="{StaticResource AmberCream}" />
            <SolidColorBrush x:Key="BrGreen" Color="{StaticResource CashGreen}" />
            <SolidColorBrush x:Key="BrRed" Color="{StaticResource CashRed}" />
            <SolidColorBrush x:Key="BrOrange" Color="{StaticResource CashOrange}" />
            <SolidColorBrush x:Key="BrPaper" Color="{StaticResource Paper}" />
            <SolidColorBrush x:Key="BrLine" Color="{StaticResource Line}" />

            <FontFamily x:Key="ArabicFont">Cairo, Tajawal, Segoe UI, Tahoma</FontFamily>

            <!-- ================== زر مسطح بحواف دائرية ================== -->
            <Style x:Key="FlatButton" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="{StaticResource BrInk700}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="2" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================== حقل إدخال ================== -->
            <Style x:Key="CyTextBox" TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="#FFF8FAFC" />
                <Setter Property="BorderBrush" Value="{StaticResource BrLine}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CyCombo" TargetType="ComboBox">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Height" Value="34" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>