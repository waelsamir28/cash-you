<Project Sdk="Microsoft.NET.Sdk">

  <!-- ==========================================================
       CASH YOU | كاش يو
       نظام مبيعات ونقاط البيع - سطح المكتب
       VB.NET / WPF / .NET 8 / SQLite
       الدعم الفني : م / وائل الجمال - 01222355769
       ========================================================== -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>CashYou</RootNamespace>
    <AssemblyName>CashYou</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <Nullable>enable</Nullable>
    <AssemblyTitle>CASH YOU - كاش يو</AssemblyTitle>
    <Company>كاش يو للتجارة والتوريدات المكتبية</Company>
    <Product>CASH YOU POS</Product>
    <Version>1.0.0</Version>
    <NeutralLanguage>ar-EG</NeutralLanguage>
    <SatelliteResourceLanguages>ar</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="cashyou.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>