{
  "name": "cash-you",
  "version": "1.2.0",
  "private": true,
  "description": "CASH YOU — نظام مبيعات ونقاط بيع عربي (سطح مكتب + ويب)",
  "author": "CASH YOU",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "desktop": "electron electron/main.cjs",
    "desktop:dist": "electron-builder --win nsis --publish never",
    "desktop:build": "node tools/make-icon.cjs && node tools/make-installer-art.cjs && node tools/build-desktop-assets.cjs",
    "test:db-bridge": "node tools/test-db-config.cjs",
    "test:local-server": "node tools/test-local-server.cjs"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "16.4.2",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.23",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.cashyou.pos",
    "productName": "CASH YOU",
    "copyright": "CASH YOU",
    "artifactName": "CASH-YOU-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "assets/branding"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "public/**/*",
      ".next/static/**/*",
      "node_modules/pg/**/*",
      "node_modules/pg-pool/**/*",
      "node_modules/pg-protocol/**/*",
      "node_modules/pg-types/**/*",
      "node_modules/pgpass/**/*",
      "node_modules/pg-connection-string/**/*",
      "node_modules/pg-int8/**/*",
      "node_modules/postgres-array/**/*",
      "node_modules/postgres-bytea/**/*",
      "node_modules/postgres-date/**/*",
      "node_modules/postgres-interval/**/*",
      "node_modules/split2/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/branding/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "electron/installer.nsh",
      "installerHeader": "installer-header.bmp",
      "installerSidebar": "installer-sidebar.bmp",
      "uninstallerSidebar": "uninstaller-sidebar.bmp",
      "installerIcon": "assets/branding/icon.ico",
      "uninstallerIcon": "assets/branding/icon.ico",
      "installerHeaderIcon": "assets/branding/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CASH YOU",
      "deleteAppDataOnUninstall": false,
      "artifactName": "CASH-YOU-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      ".next/static/**/*",
      "node_modules/pg/**/*",
      "node_modules/pg-pool/**/*",
      "node_modules/pg-protocol/**/*",
      "node_modules/pg-types/**/*",
      "node_modules/pgpass/**/*",
      "node_modules/pg-connection-string/**/*",
      "node_modules/pg-int8/**/*",
      "node_modules/postgres-array/**/*",
      "node_modules/postgres-bytea/**/*",
      "node_modules/postgres-date/**/*",
      "node_modules/postgres-interval/**/*",
      "node_modules/split2/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
