{
  "name": "cash-you-installer",
  "version": "1.4.2",
  "description": "مثبّت CASH YOU المخصص",
  "main": "main.cjs",
  "build": {
    "appId": "com.cashyou.installer",
    "productName": "CASH-YOU-Setup",
    "directories": {
      "output": "../release-installer"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "styles.css",
      "renderer.js",
      "assets/**/*"
    ],
    "extraResources": [
      { "from": "payload.7z", "to": "payload.7z" },
      { "from": "bin/7za.exe", "to": "7za.exe" }
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "../public/desktop/icon.ico"
    },
    "portable": {
      "artifactName": "CASH-YOU-Setup-${version}.exe"
    }
  }
}
