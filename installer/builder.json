{
  "appId": "com.cashyou.installer",
  "productName": "CASH-YOU-Setup",
  "directories": {
    "app": "installer",
    "output": "release-installer"
  },
  "files": [
    "main.cjs",
    "preload.cjs",
    "index.html",
    "styles.css",
    "renderer.js",
    "assets/**/*"
  ],
  "extraResources": [
    { "from": "installer/payload.7z", "to": "payload.7z" },
    { "from": "installer/bin/7za.exe", "to": "7za.exe" }
  ],
  "win": {
    "target": [
      { "target": "portable", "arch": ["x64"] }
    ],
    "icon": "public/desktop/icon.ico"
  },
  "portable": {
    "artifactName": "CASH-YOU-Setup-${version}.exe"
  }
}
